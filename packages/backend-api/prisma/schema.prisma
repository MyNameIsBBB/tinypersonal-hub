generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     LegacyTask[]
}

enum ScheduleItemType {
  EVENT
  TASK
  ROUTINE
}

enum ScheduleStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SchedulePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model ScheduleItem {
  id              String           @id @default(cuid())
  title           String
  description     String?
  type            ScheduleItemType
  startTime       DateTime?
  endTime         DateTime?
  isAllDay        Boolean          @default(false)
  status          ScheduleStatus   @default(PENDING)
  priority        SchedulePriority @default(MEDIUM)
  recurrenceRule  String?
  routineEndDate  DateTime?
  parentRoutineId String?
  parentRoutine   ScheduleItem?    @relation("RoutineToInstances", fields: [parentRoutineId], references: [id], onDelete: Cascade)
  routineChildren ScheduleItem[]   @relation("RoutineToInstances")
  notes           Note[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([type, startTime])
  @@index([status])
  @@index([parentRoutineId])
}

model LegacyTask {
  id          String    @id @default(cuid())
  title       String
  startsAt    DateTime?
  completedAt DateTime?
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("Task")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id String @id @default(cuid())
  ownerKey String
  title String
  description String?
  requirements String?
  status TaskStatus @default(TODO)
  priority TaskPriority @default(MEDIUM)
  deadline DateTime?
  startAt DateTime?
  progressNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  completedAt DateTime?
  checklistItems TaskChecklistItem[]

  @@index([ownerKey, status, deadline])
  @@map("WorkTask")
}

model TaskChecklistItem {
  id String @id @default(cuid())
  taskId String
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title String
  isCompleted Boolean @default(false)
  order Int
  createdAt DateTime @default(now())
  completedAt DateTime?

  @@index([taskId, order])
}

model Note {
  id             String        @id @default(cuid())
  title          String
  content        String
  tagsJson       String        @default("[]")
  folder         String?
  searchText     String        @default("")
  embeddingJson  String?
  scheduleItemId String?
  scheduleItem   ScheduleItem? @relation(fields: [scheduleItemId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([folder])
  @@index([scheduleItemId])
}

model VaultSecret {
  id                String   @id @default(cuid())
  serviceName       String
  category          String
  accountIdentifier String
  encryptedPassword String
  iv                String
  authTag           String
  encryptedTotpSeed String?
  totpIv            String?
  totpAuthTag       String?
  url               String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([serviceName])
  @@index([category])
}

model NotificationDelivery {
  id             String   @id @default(cuid())
  idempotencyKey String
  channel        String
  status         String
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([idempotencyKey, channel])
  @@index([createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  ownerKey  String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerKey])
}

model ToolVector {
  id          String   @id @default(cuid())
  name        String   @unique
  content     String
  contentHash String
  vectorJson  String
  dimensions  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChatSession {
  id                 String        @id @default(cuid())
  ownerKey           String
  title              String?
  customSystemPrompt String?
  conversationStateJson String?
  messages           ChatMessage[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([ownerKey, updatedAt])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  messageId String
  role      String
  payloadJson String
  createdAt DateTime    @default(now())

  @@unique([sessionId, messageId])
  @@index([sessionId, createdAt])
}

model PendingAction {
  id          String   @id @default(cuid())
  ownerKey    String
  sessionId   String?
  toolName    String
  argumentsJson String
  dedupeKey   String?
  summary     String
  status      String   @default("PENDING")
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?

  @@index([ownerKey, status, expiresAt])
}

// Historical records only: excluded from the generated client; no worker executes them.
model RetiredCodingJob {
  @@map("CodingJob")
  @@ignore

  id            String   @id @default(cuid())
  ownerKey      String
  sessionId     String
  userMessageId String
  inputJson     String
  status        String   @default("QUEUED")
  attempts      Int      @default(0)
  leaseUntil    DateTime?
  resultJson    String?
  progressJson  String   @default("[]")
  error         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  completedAt   DateTime?

  @@index([status, createdAt])
  @@index([ownerKey, sessionId, createdAt])
}

model ChatGenerationJob {
  id            String   @id @default(cuid())
  ownerKey      String
  sessionId     String
  userMessageId String
  inputJson     String   @default("{}")
  status        String   @default("QUEUED")
  attempts      Int      @default(0)
  leaseUntil    DateTime?
  error         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  completedAt   DateTime?

  @@unique([sessionId, userMessageId])
  @@index([status, createdAt])
  @@index([ownerKey, sessionId, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String
  action      String
  targetType  String?
  targetId    String?
  status      String
  promptVersion String?
  metadataJson String  @default("{}")
  createdAt   DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model AgentRunTrace {
  id               String   @id @default(cuid())
  ownerKey         String
  sessionId        String
  userMessageId    String
  intent           String
  contextJson      String   @default("[]")
  allowedToolsJson String   @default("[]")
  model            String
  status           String   @default("RUNNING")
  toolCallsJson    String   @default("[]")
  finalResponse    String?
  durationMs       Int?
  error            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  completedAt      DateTime?

  @@index([ownerKey, createdAt])
  @@index([sessionId, createdAt])
  @@index([status, createdAt])
}

enum MemoryType {
  FACT
  EPISODE
  PREFERENCE
  PROJECT
  RELATIONSHIP
  INFERRED_PATTERN
}

enum MemoryStatus {
  ACTIVE
  SUPERSEDED
  DISPUTED
  RETRACTED
}

enum MemorySensitivity {
  NORMAL
  PRIVATE
  RESTRICTED
}

model PersonalMemory {
  id                String            @id @default(cuid())
  ownerKey          String
  type              MemoryType
  subject           String
  predicate         String?
  claim             String
  confidence        Float
  source            String
  sourceSessionId   String?
  sourceMessageId   String?
  evidenceJson      String            @default("[]")
  validFrom         DateTime?
  validUntil        DateTime?
  observedAt        DateTime
  lastConfirmedAt   DateTime?
  status            MemoryStatus      @default(ACTIVE)
  sensitivity       MemorySensitivity @default(PRIVATE)
  searchText        String
  embeddingJson     String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([ownerKey, sourceMessageId, claim])
  @@index([ownerKey, status, type])
  @@index([ownerKey, subject])
  @@index([ownerKey, updatedAt])
}

model MemoryProcessingRun {
  id              String   @id @default(cuid())
  ownerKey        String
  sessionId       String
  sourceMessageId String
  status          String
  extractedCount  Int      @default(0)
  error           String?
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  @@unique([ownerKey, sourceMessageId])
  @@index([ownerKey, status, createdAt])
}

model UserModelSnapshot {
  id                   String   @id @default(cuid())
  ownerKey             String
  version              Int
  modelJson            String
  basedOnMemoryIdsJson String   @default("[]")
  supersedesId         String?
  throughRunAt         DateTime?
  source               String   @default("REFLECTION")
  createdAt            DateTime @default(now())

  @@unique([ownerKey, version])
  @@index([ownerKey, createdAt])
}

model UserModelProposal {
  id                   String   @id @default(cuid())
  ownerKey             String
  baseSnapshotId       String?
  proposedModelJson    String
  changesJson          String   @default("[]")
  basedOnMemoryIdsJson String   @default("[]")
  status               String   @default("PENDING")
  createdAt            DateTime @default(now())
  resolvedAt           DateTime?

  @@index([ownerKey, status, createdAt])
}

model RelationshipTimelineEvent {
  id           String   @id @default(cuid())
  ownerKey     String
  occurredAt   DateTime
  category     String
  description  String
  confidence   Float
  evidenceJson String   @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ownerKey, occurredAt])
}
