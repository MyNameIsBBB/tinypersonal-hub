generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]
}

enum ScheduleItemType {
  EVENT
  TASK
  ROUTINE
}

enum ScheduleStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SchedulePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model ScheduleItem {
  id              String           @id @default(cuid())
  title           String
  description     String?
  type            ScheduleItemType
  startTime       DateTime?
  endTime         DateTime?
  isAllDay        Boolean          @default(false)
  status          ScheduleStatus   @default(PENDING)
  priority        SchedulePriority @default(MEDIUM)
  recurrenceRule  String?
  routineEndDate  DateTime?
  parentRoutineId String?
  parentRoutine   ScheduleItem?    @relation("RoutineToInstances", fields: [parentRoutineId], references: [id], onDelete: Cascade)
  routineChildren ScheduleItem[]   @relation("RoutineToInstances")
  notes           Note[]
  mediaAssets     MediaAsset[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([type, startTime])
  @@index([status])
  @@index([parentRoutineId])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  startsAt    DateTime?
  completedAt DateTime?
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Note {
  id             String        @id @default(cuid())
  title          String
  content        String
  tagsJson       String        @default("[]")
  folder         String?
  searchText     String        @default("")
  embeddingJson  String?
  scheduleItemId String?
  scheduleItem   ScheduleItem? @relation(fields: [scheduleItemId], references: [id], onDelete: SetNull)
  mediaAssets    MediaAsset[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([folder])
  @@index([scheduleItemId])
}

model MediaAsset {
  id             String        @id @default(cuid())
  fileName       String
  mimeType       String
  fileSize       Int
  storageDriver  String        @default("local")
  storagePath    String
  publicUrl      String?
  checksumSha256 String
  noteId         String?
  note           Note?         @relation(fields: [noteId], references: [id], onDelete: Cascade)
  scheduleItemId String?
  scheduleItem   ScheduleItem? @relation(fields: [scheduleItemId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@index([noteId])
  @@index([scheduleItemId])
}

model VaultSecret {
  id                String   @id @default(cuid())
  serviceName       String
  category          String
  accountIdentifier String
  encryptedPassword String
  iv                String
  authTag           String
  encryptedTotpSeed String?
  totpIv            String?
  totpAuthTag       String?
  url               String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([serviceName])
  @@index([category])
}

model NotificationDelivery {
  id             String   @id @default(cuid())
  idempotencyKey String
  channel        String
  status         String
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([idempotencyKey, channel])
  @@index([createdAt])
}
