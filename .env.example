# AI provider
APP_VERSION=
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional low-latency model for ambiguous intent classification. Falls back to GEMINI_MODEL.
GEMINI_CLASSIFIER_MODEL=gemini-3.5-flash-lite

# Database (SQLite is convenient for local development)
DATABASE_URL="file:./dev.db"

# Core app + security
VAULT_MASTER_KEY=
PERSONAL_API_TOKEN=
APP_AUTH_USERNAME=
APP_AUTH_PASSWORD=
SESSION_SIGNING_KEY=
VAULT_REVEAL_PASSWORD=

# Optional RSS feed for important news (defaults to Google News Thailand)
NEWS_RSS_URL=https://news.google.com/rss?hl=th&gl=TH&ceid=TH:th

# Self-hosted web search
SEARXNG_BASE_URL=http://127.0.0.1:8080
SEARXNG_SECRET=tinypersonal-local-searxng-change-me

# Proactive morning briefing (08:00 Asia/Bangkok / host local time)
CRON_SECRET=
TINYPERSONAL_BASE_URL=http://127.0.0.1:3000
DISCORD_WEBHOOK_URL=
# Discord interactions (slash commands /assistant and /vm)
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
# Comma-separated Discord user IDs. Empty means nobody can run commands.
DISCORD_ALLOWED_USER_IDS=
# Optional comma-separated channel allowlist. Empty allows all channels visible to the app.
DISCORD_ALLOWED_CHANNEL_IDS=
# Optional existing TinyPersonal owner key (for example user:alice). Defaults to an isolated discord:<user-id> owner.
DISCORD_OWNER_KEY=
# Optional: register commands instantly in one test server; omit for global commands.
DISCORD_GUILD_ID=
# Generate with: npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.com
SCHEDULE_NOTIFICATION_LEAD_MINUTES=30

# Proxmox API token (the API endpoint must use a trusted HTTPS certificate)
PROXMOX_BASE_URL=https://proxmox.example.com:8006
PROXMOX_TOKEN_ID=root@pam!tinypersonal
PROXMOX_TOKEN_SECRET=
