# AI provider
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Database (SQLite is convenient for local development)
DATABASE_URL="file:./dev.db"

# Vault: generate 32 random bytes and encode as base64. Never share this key with AI.
VAULT_MASTER_KEY=

# Media storage: local (Docker-friendly) or s3 (AWS S3, R2, MinIO)
MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_ROOT=.data/media
MEDIA_SIGNING_KEY=
PERSONAL_API_TOKEN=
APP_AUTH_USERNAME=
APP_AUTH_PASSWORD=
SESSION_SIGNING_KEY=
VAULT_REVEAL_PASSWORD=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional external integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GMAIL_FROM_ADDRESS=
FINANCE_API_KEY=
