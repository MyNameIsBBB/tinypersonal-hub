# AI provider
APP_VERSION=
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Database (SQLite is convenient for local development)
DATABASE_URL="file:./dev.db"

# Core app + security
VAULT_MASTER_KEY=
PERSONAL_API_TOKEN=
APP_AUTH_USERNAME=
APP_AUTH_PASSWORD=
SESSION_SIGNING_KEY=
VAULT_REVEAL_PASSWORD=

# Optional external integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GMAIL_FROM_ADDRESS=
FINANCE_API_KEY=
# Optional RSS feed for important news (defaults to Google News Thailand)
NEWS_RSS_URL=https://news.google.com/rss?hl=th&gl=TH&ceid=TH:th

# Self-hosted web search
SEARXNG_BASE_URL=http://127.0.0.1:8080
SEARXNG_SECRET=tinypersonal-local-searxng-change-me

# Proactive morning briefing (08:00 Asia/Bangkok / host local time)
CRON_SECRET=
TINYPERSONAL_BASE_URL=http://127.0.0.1:3000
DISCORD_WEBHOOK_URL=
# Generate with: npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.com
SCHEDULE_NOTIFICATION_LEAD_MINUTES=30

# Host-side Codex coding worker (repository and credentials stay outside Docker)
HOST_JARVIS_PROJECT_ROOT=/home/best/codex-playground
CODEX_WORKER_DIR=/tmp/tinypersonal-codex-worker

# Optional Home Assistant control for Jarvis
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
