# AI provider
APP_VERSION=
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Database (SQLite is convenient for local development)
DATABASE_URL="file:./dev.db"

# Core app + security
VAULT_MASTER_KEY=
MEDIA_SIGNING_KEY=
PERSONAL_API_TOKEN=
APP_AUTH_USERNAME=
APP_AUTH_PASSWORD=
SESSION_SIGNING_KEY=
VAULT_REVEAL_PASSWORD=

# Media storage
MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_ROOT=.data/media
# S3 / MinIO settings (required when MEDIA_STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional external integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GMAIL_FROM_ADDRESS=
FINANCE_API_KEY=
# Optional RSS feed for important news (defaults to Google News Thailand)
NEWS_RSS_URL=https://news.google.com/rss?hl=th&gl=TH&ceid=TH:th

# Self-hosted web search
SEARXNG_BASE_URL=http://127.0.0.1:8080
SEARXNG_SECRET=tinypersonal-local-searxng-change-me

# Proactive morning briefing (08:00 Asia/Bangkok / host local time)
CRON_SECRET=
TINYPERSONAL_BASE_URL=http://127.0.0.1:3000
DISCORD_WEBHOOK_URL=
# Generate with: npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.com
SCHEDULE_NOTIFICATION_LEAD_MINUTES=30

# JARVIS local coding runner and Home Assistant
JARVIS_PROJECT_ROOT=/absolute/path/to/tinypersonal-hub
JARVIS_CODING_CLI=codex
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
