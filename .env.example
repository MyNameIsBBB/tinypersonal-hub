# AI provider
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Database (SQLite is convenient for local development)
DATABASE_URL="file:./dev.db"

# Core app + security
VAULT_MASTER_KEY=
MEDIA_SIGNING_KEY=
PERSONAL_API_TOKEN=
APP_AUTH_USERNAME=
APP_AUTH_PASSWORD=
SESSION_SIGNING_KEY=
VAULT_REVEAL_PASSWORD=

# Media storage
MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_ROOT=.data/media
# S3 / MinIO settings (required when MEDIA_STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional external integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GMAIL_FROM_ADDRESS=
FINANCE_API_KEY=
