{
  "name": "tinypersonal-hub",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "./scripts/start-dev.sh",
    "dev:mobile": "ENABLE_TAILSCALE_FUNNEL=1 ./scripts/start-dev.sh",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:integration": "vitest run packages/personal-app/src/app/api/api.integration.test.ts",
    "test:eval": "vitest run --config vitest.eval.config.ts packages/assistant-core/src/evals/routingEval.test.ts packages/assistant-core/src/evals/capabilityEval.test.ts",
    "db:generate": "npm run db:generate --workspace=@tinypersonal/backend-api",
    "db:migrate": "npm run db:migrate --workspace=@tinypersonal/backend-api",
    "db:deploy": "npm run db:deploy --workspace=@tinypersonal/backend-api",
    "docker:up": "./start-compose.sh",
    "docker:backup": "./scripts/backup-docker-data.sh",
    "docker:restore": "./scripts/restore-docker-data.sh",
    "import:tinyschedule": "node ./scripts/import-tinyschedule-schedules.mjs",
    "funnel:check": "./scripts/check-funnel-health.sh",
    "funnel:install-autofix": "./scripts/install-funnel-autofix-cron.sh",
    "funnel:install-autofix-systemd": "./scripts/install-funnel-autofix-systemd.sh",
    "briefing:run": "node ./scripts/run-morning-briefing.mjs",
    "briefing:install-cron": "./scripts/install-morning-briefing-cron.sh",
    "briefing:install-systemd": "bash ./scripts/install-morning-briefing-systemd.sh",
    "docker:install-systemd": "bash ./scripts/install-start-docker-systemd.sh",
    "search:up": "./scripts/start-searxng.sh",
    "search:logs": "docker compose logs --tail=100 searxng",
    "discord:register": "node ./scripts/register-discord-commands.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
